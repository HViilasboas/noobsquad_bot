DISCORD_TOKEN=
REBOOT_CHANNEL_ID=
CHAT_JUKEBOX=

NOTIFICATION_CHANNEL_ID=

MONGODB_URI=
DATABASE_NAME=noobsquad_bot

YOUTUBE_API_KEY=

# Crie uma aplicação em https://developer.spotify.com/dashboard para importar playlists públicas.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

CHECK_YOUTUBE_INTERVAL=300
CHECK_TWITCH_INTERVAL=180

# Steam (não requer chave de API para lançamentos comunitários)
STEAM_CHECK_INTERVAL=21600
STEAM_RELEASE_WINDOW_DAYS=90
STEAM_REQUEST_TIMEOUT=20

# Compartilhamento de tela pelo navegador (MediaMTX/WebRTC)
STREAM_WEB_HOST=0.0.0.0
STREAM_WEB_PORT=8080
STREAM_DOMAIN=noobsquad.ddns.net
STREAM_HTTP_PORT=28080
STREAM_PUBLIC_PORT=28443
STREAM_MEDIA_UDP_PORT=28189
STREAM_PUBLIC_URL=https://noobsquad.ddns.net:28443
STREAM_PUBLIC_ORIGIN=https://noobsquad.ddns.net:28443
STREAM_MEDIA_URL=https://noobsquad.ddns.net:28443/media
STREAM_MEDIA_PUBLIC_HOST=noobsquad.ddns.net,177.6.237.189,192.168.1.128
STREAM_MEDIA_API_URL=http://127.0.0.1:9997
STREAM_SESSION_MAX_MINUTES=240
STREAM_ICE_SERVER_0_URL=stun:stun.l.google.com:19302
STREAM_ICE_SERVER_1_URL=stun:stun1.l.google.com:19302
# Para TURN, use AUTH_SECRET e o mesmo segredo compartilhado com o servidor TURN.
STREAM_ICE_SERVER_1_USERNAME=
STREAM_ICE_SERVER_1_PASSWORD=

# Links e sinalização usam o hostname DDNS; o registro deve apontar para o IP WAN público.
# Instale a cadeia PEM e a chave correspondente em caddy_certs/ (arquivos ignorados pelo Git).
# Encaminhe TCP 28443 para 28443 e TCP/UDP 28189 para 28189; 28080 é o redirecionamento HTTP opcional.
# As portas 80/443 não são necessárias. Não exponha 8080, 8889, 9997 ou 27017.
